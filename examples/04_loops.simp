# Loops: repeat, repeat while, for ... from ... to, for each
repeat 3 times
    say "Hip hip hooray!"
end repeat

for i from 1 to 5
    say "{i} x 7 = {i * 7}"
end for

say "Countdown:"
for i from 3 to 1
    say i
end for
say "Lift off!"

set n to 1
repeat while n < 100
    set n to n * 2
end repeat
say "First power of 2 above 100 is", n

for each fruit in ["apple", "banana", "cherry"]
    if fruit is "banana" then
        skip          # jump to the next fruit
    end if
    say "I like", fruit
end for
