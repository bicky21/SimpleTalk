;; Loops: a count, a range, a list, while, and forever
loop 3
    out "Hip hip hooray!"
.

loop i 1..5
    out "{i} x 7 = {i * 7}"
.

out "Countdown:"
loop i 3..1
    out i
.
out "Lift off!"

let n 1
loop while n < 100
    let n n * 2
.
out "First power of 2 above 100 is", n

loop fruit ["apple", "banana", "cherry"]
    when fruit = "banana"
        skip          ;; jump to the next fruit
    .
    out "I like", fruit
.
