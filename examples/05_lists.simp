# Lists start at position 1. Position -1 is the last item.
set shopping to ["milk", "eggs"]
add "bread" to shopping
say shopping
say "First:", shopping[1], "| Last:", shopping[-1]
say "Items:", length(shopping)

remove "eggs" from shopping
set shopping[1] to "oat milk"
say shopping

if "bread" in shopping then
    say "Don't forget the bread!"
end if

set scores to [70, 95, 82]
say "Best:", max(scores), "Total:", sum(scores), "Sorted:", sort(scores)
