;; Lists start at position 1. Position -1 is the last item.
let shopping ["milk", "eggs"]
add shopping "bread"
out shopping
out "First:", shopping[1], "| Last:", shopping[-1]
out "Items:", len(shopping)

del shopping "eggs"
let shopping[1] "oat milk"
out shopping

when shopping has "bread"
    out "Don't forget the bread!"
.

let scores [70, 95, 82]
out "Best:", max(scores), "Total:", sum(scores), "Sorted:", sort(scores)
