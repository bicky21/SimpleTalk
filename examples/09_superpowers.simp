;; SimpleTalk's built-in helpers: watch, test and smart input.
;; Try:  simpletalk --explain examples/09_superpowers.simp
;;       simpletalk --trace examples/09_superpowers.simp

fn square n
    ret n * n
.

;; Tests live right next to your code.
test square(3) = 9
test square(-4) = 16
test [1, 2, 3] has 2

;; watch reports every change to a variable.
let score 0
watch score
loop round 1..3
    up score round * 10
.

let basket ["apple"]
watch basket
add basket "kiwi"

;; Smart input: keeps asking until the answer fits.
in age num "How old are you?"
in likes yes "Do you like coding? (yes/no)"
when likes
    out "Great! In 10 years you'll be {age + 10} and coding even better."
else
    out "No problem, maybe SimpleTalk will change your mind."
.
