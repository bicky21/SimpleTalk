;; A small game: guess the secret number
let secret rand(1, 20)
let tries 0
out "I'm thinking of a number between 1 and 20."

loop
    in guess "Your guess?"
    when not isnum(guess)
        out "Please type a number."
        skip
    .
    when guess < 1 or guess > 20
        out "Stay between 1 and 20!"
        skip
    .
    up tries
    when guess < secret
        out "Too low!"
    else when guess > secret
        out "Too high!"
    else
        out "Correct! You got it in {tries} tries."
        stop
    .
.
