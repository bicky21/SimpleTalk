{
  "when": {
    "prefix": "when",
    "body": ["when ${1:check}", "\t$0", "."],
    "description": "Run code only when something is true"
  },
  "when / else": {
    "prefix": "whenelse",
    "body": ["when ${1:check}", "\t${2}", "else", "\t$0", "."],
    "description": "Choose between two blocks"
  },
  "loop N times": {
    "prefix": "loop",
    "body": ["loop ${1:3}", "\t$0", "."],
    "description": "Repeat a number of times"
  },
  "loop over a range": {
    "prefix": "loopi",
    "body": ["loop ${1:i} ${2:1}..${3:10}", "\t$0", "."],
    "description": "Count from one number to another"
  },
  "loop over items": {
    "prefix": "loopeach",
    "body": ["loop ${1:item} ${2:items}", "\t$0", "."],
    "description": "Go through every item of a list (or key of a map)"
  },
  "loop while": {
    "prefix": "loopwhile",
    "body": ["loop while ${1:check}", "\t$0", "."],
    "description": "Repeat while something is true"
  },
  "function": {
    "prefix": "fn",
    "body": ["fn ${1:name} ${2:input}", "\t${0}ret ${2:input}", "."],
    "description": "Make your own function"
  },
  "try / fail": {
    "prefix": "try",
    "body": ["try", "\t${1}", "fail ${2:why}", "\tout \"Problem:\", ${2:why}", "."],
    "description": "Catch problems instead of stopping"
  },
  "pick": {
    "prefix": "pick",
    "body": ["pick ${1:value}", "is ${2:1}", "\t${3}", "else", "\t$0", "."],
    "description": "Choose by value or range"
  },
  "task": {
    "prefix": "task",
    "body": ["task ${1:name}", "\t$0", ".", "await ${1:name}"],
    "description": "Run something side by side"
  },
  "map": {
    "prefix": "map",
    "body": ["let ${1:me} {${2:name}: ${3:\"Bicky\"}}"],
    "description": "Make a map of named values"
  },
  "pipeline": {
    "prefix": "pipe",
    "body": ["${1:items} | only ${2:it > 0} | each ${3:it * 2}"],
    "description": "Filter and transform a list"
  },
  "test": {
    "prefix": "test",
    "body": ["test ${1:square(3)} = ${2:9}"],
    "description": "Check that something is true"
  }
}
